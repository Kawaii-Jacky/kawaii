{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASTRA",
  "version": "0.1.16",
  "identifier": "xyz.astroy.app",
  "build": {
    "frontendDist": "../../../remote-observatory-frontend",
    "devUrl": "http://localhost:4173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "ASTRA", "width": 1280, "height": 820, "resizable": true }],
    "security": { "csp": "default-src 'self' https: data: blob:; connect-src 'self' https: wss:; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https: 'wasm-unsafe-eval'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } },
    "android": { "minSdkVersion": 26 }
  }
}
