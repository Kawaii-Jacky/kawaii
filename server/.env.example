SQLITE_PATH=./data/astroy.db
POSTGRES_DB=astroy
POSTGRES_USER=astra
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# Compose injects DATABASE_URL. Set it directly only when running without Compose.
DATABASE_URL=
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=backend-controller
MQTT_PASSWORD=CHANGE_ME_BACKEND_PASSWORD
# Optional multi-controller mode. Store the real JSON only under server/.secrets/.
# MQTT_CONTROLLERS_FILE=/run/astra-secrets/mqtt-controllers.json
# Optional container-only override for legacy loopback controller entries.
# MQTT_INTERNAL_HOST=mosquitto
# Set MQTT_DISABLED=1 to run API without a broker during UI development.
MQTT_DISABLED=0
MQTT_MAX_PAYLOAD_BYTES=65536
MQTT_MAX_MESSAGES_PER_SECOND=30
TELEMETRY_RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Release deployments bind Nginx to loopback by default; Cloudflare reaches the
# web service over the Compose network. Set 0.0.0.0 only with a host firewall.
ASTRA_WEB_BIND=127.0.0.1
ASTRA_WEB_PORT=8000
# Comma-separated exact browser origins allowed to make cookie-authenticated
# POST/PUT/PATCH/DELETE requests. Defaults to CORS_ORIGINS when omitted.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8100,http://127.0.0.1:8100
WEATHER_CACHE_MAX_ENTRIES=256
WEATHER_RATE_LIMIT=120
WEATHER_RATE_WINDOW_SECONDS=300
AUTH_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_SESSION_DAYS=7
# Set to 0 only for a loopback-only local development console.
ADMIN_LOGIN_RATE_LIMIT_ENABLED=1
ADMIN_LOGIN_FAILURE_LIMIT=5
ADMIN_LOGIN_FAILURE_IP_LIMIT=15
ADMIN_LOGIN_FAILURE_WINDOW_SECONDS=900
# Safe JSON import limits for the administrator console.
DATABASE_IMPORT_MAX_BYTES=26214400
DATABASE_IMPORT_MAX_ROWS=250000
AUTH_COOKIE_SECURE=0
AUTH_COOKIE_SAMESITE=lax
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_COOLDOWN_SECONDS=60
# Keep account passwords at nine or more characters; MQTT credentials remain 12+.
# Development-only override: keep this disabled in every deployed environment.
AUTH_DEBUG_CODES=0

# Bootstrap the administrator. Installers set password sync so this account can
# be recovered after a database migration; never commit the real password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=ASTRA 管理员
ADMIN_PASSWORD_SYNC=0
# Reserved super administrator identity is fixed in server code as 123@qq.com.
# Production installers require a private password for it.
SUPER_ADMIN_PASSWORD=

# Email verification provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
SMTP_SSL=0

# Phone verification adapter. The URL receives JSON with phone/code/purpose/product.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_GATEWAY_MODE=mock
# Native Aliyun SMS adapter. Keep mode=mock until the signature and templates
# have been approved and all required server-only values are populated.
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
# Use one shared template, or leave this empty and set both purpose templates.
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_TEMPLATE_CODE_REGISTER=
ALIYUN_SMS_TEMPLATE_CODE_RECOVER=
ALIYUN_SMS_REGION_ID=cn-hangzhou
# Aliyun Phone Number Verification Service (SMS Authentication). This is the
# preferred mode for individual developers and uses system-gifted sign/template.
ALIYUN_PNVS_ACCESS_KEY_ID=
ALIYUN_PNVS_ACCESS_KEY_SECRET=
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=
ALIYUN_PNVS_SCHEME_NAME=ASTRA
ALIYUN_PNVS_VALID_MINUTES=10
ALIYUN_PNVS_INTERVAL_SECONDS=60
CLOUDFLARED_TOKEN_FILE=/root/.cloudflared/home-iot.token
# Encrypted backup policy. The scheduler invokes scripts/backup.sh daily.
ASTROY_BACKUP_RETENTION_DAYS=14
ASTROY_BACKUP_MIN_FREE_GB=5
