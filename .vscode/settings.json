{
  "editor.fontFamily": "'Geist Mono', 'JetBrains Mono', 'SF Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 20,
  "editor.fontWeight": "normal",
  "workbench.colorCustomizations": {
    "editor.foreground": "#e0e0e0" // 现代灰白色（避开刺眼的纯白，更柔和高级）
  },
  "git.ignoreLimitWarning": true,
  // 新开的聊天会话默认使用「Allow all」（代码里的 autoApprove 档），不再逐个工具弹确认
  "chat.permissions.default": "autoApprove"
}